@echo off
title SOZIP LAUNCHER Setup
setlocal EnableExtensions
rem ---------------------------------------------------------------
rem  SOZIP LAUNCHER - Windows installer (self-contained, no Python,
rem  no packaging tools, plain script = nothing for AVs to suspect)
rem ---------------------------------------------------------------

set "SOZIP_SELF=%~f0"
set "SOZIP_PSTMP=%TEMP%\sozip-setup-%RANDOM%%RANDOM%.ps1"

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $t=$env:SOZIP_PSTMP; $s=[IO.File]::ReadAllText($env:SOZIP_SELF); $m='#'+'SOZIP_PS_BEGIN'; $i=$s.IndexOf($m); if($i -lt 0){throw 'Installer payload missing.'}; [IO.File]::WriteAllText($t,$s.Substring($i),(New-Object System.Text.UTF8Encoding($true))); & $t"
set "EC=%ERRORLEVEL%"
del /q "%SOZIP_PSTMP%" >nul 2>&1
if not "%EC%"=="0" (
  echo.
  echo   Sorry - the setup could not start. ^(Error %EC%^)
  echo.
  pause
)
endlocal
exit /b %EC%

#SOZIP_PS_BEGIN
# =================================================================
#  SOZIP LAUNCHER - Windows setup payload (PowerShell + WPF)
# =================================================================

$ErrorActionPreference = 'Stop'

$Url     = 'https://github.com/sozipp/sozip-launcher/releases/latest/download/launcher.exe'
$ExeName = 'launcher.exe'
$IcoB64  = ''
$PngB64  = ''

Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName PresentationCore
Add-Type -AssemblyName WindowsBase
Add-Type -AssemblyName System.Windows.Forms

function ConvertTo-Brush([string]$hex) {
  New-Object System.Windows.Media.SolidColorBrush ([System.Windows.Media.ColorConverter]::ConvertFromString($hex))
}

$iconFrame = $null
try {
  $icoBytes = [Convert]::FromBase64String($IcoB64)
  $icoStream = New-Object System.IO.MemoryStream (,$icoBytes)
  $iconFrame = [Windows.Media.Imaging.BitmapFrame]::Create($icoStream)
} catch { }

$logoImage = $null
try {
  $pngBytes = [Convert]::FromBase64String($PngB64)
  $pngStream = New-Object System.IO.MemoryStream (,$pngBytes)
  $logoImage = New-Object System.Windows.Media.Imaging.BitmapImage
  $logoImage.BeginInit()
  $logoImage.CacheOption = [Windows.Media.Imaging.BitmapCacheOption]::OnLoad
  $logoImage.StreamSource = $pngStream
  $logoImage.EndInit()
  $logoImage.Freeze()
} catch { }

$xaml = @'
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOZIP LAUNCHER Setup" Width="680" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#101218" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="#7C5CFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#6A4BE6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#5A3FD1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#272C3A"/>
                <Setter Property="Foreground" Value="#6E7484"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#232838"/>
      <Setter Property="Foreground" Value="#D7DBE4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2D3346"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#1C2029"/>
                <Setter Property="Foreground" Value="#565C6B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="30,24,30,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,16">
      <Image Name="Logo" Height="88" Stretch="Uniform" Margin="0,0,0,10"/>
      <TextBlock Text="SOZIP LAUNCHER" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"/>
      <TextBlock Text="The free &amp; open source Minecraft launcher - everything lives in one folder."
                 FontSize="13" Foreground="#9AA3B2" Margin="0,7,0,0" TextAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#171B25" BorderBrush="#242A39" BorderThickness="1"
            CornerRadius="14" Padding="24,20,24,18" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock Text="WHERE DO YOU WANT TO INSTALL SOZIP LAUNCHER?" FontSize="11.5" FontWeight="SemiBold" Foreground="#8F7BFF"/>
        <DockPanel Margin="0,10,0,0">
          <Button Name="BtnBrowse" Width="94" Height="34" Margin="10,0,0,0" DockPanel.Dock="Right"
                  Content="Browse..." Style="{StaticResource GhostButton}"/>
          <TextBox Name="TxtDir" Height="34" VerticalContentAlignment="Center" Padding="9,0"
                   Background="#20242F" Foreground="#EAECF2" BorderBrush="#2E3547" BorderThickness="1" FontSize="13"/>
        </DockPanel>
        <TextBlock Text="Everything stays inside the folder you select - the launcher, Minecraft files and settings. Type a path or browse; delete that folder later to fully uninstall."
                   FontSize="11.5" Foreground="#7E8595" TextWrapping="Wrap" Margin="0,9,0,12"/>
        <CheckBox Name="ChkDesktop" IsChecked="True" Content="Create a desktop shortcut with the SOZIP icon"
                  Foreground="#C9CEDA" FontSize="12.5" Margin="0,3,0,0"/>
        <CheckBox Name="ChkMenu" IsChecked="True" Content="Add to Start Menu, so you can search &quot;SOZIP&quot;"
                  Foreground="#C9CEDA" FontSize="12.5" Margin="0,7,0,0"/>
        <CheckBox Name="ChkRun" IsChecked="True" Content="Run SOZIP LAUNCHER when setup finishes"
                  Foreground="#C9CEDA" FontSize="12.5" Margin="0,7,0,0"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <Button Name="BtnInstall" Content="INSTALL" Style="{StaticResource AccentButton}"/>
      <ProgressBar Name="Bar" Height="6" Minimum="0" Maximum="100" Margin="0,12,0,0"
                   Foreground="#7C5CFF" Background="#20242F" BorderThickness="0" Visibility="Collapsed"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Name="TxtStatus" Text="" FontSize="12.5" Foreground="#7E8595"
               Margin="0,14,0,0" TextWrapping="Wrap"/>

    <TextBlock Grid.Row="5" Text="Portable  -  No admin rights  -  github.com/sozipp/sozip-launcher"
               FontSize="11" Foreground="#596072" TextAlignment="Center"/>
  </Grid>
</Window>
'@

$win = [Windows.Markup.XamlReader]::Parse($xaml)
if ($iconFrame) { $win.Icon = $iconFrame }

$Logo       = $win.FindName('Logo')
$TxtDir     = $win.FindName('TxtDir')
$BtnBrowse  = $win.FindName('BtnBrowse')
$ChkDesktop = $win.FindName('ChkDesktop')
$ChkMenu    = $win.FindName('ChkMenu')
$ChkRun     = $win.FindName('ChkRun')
$BtnInstall = $win.FindName('BtnInstall')
$Bar        = $win.FindName('Bar')
$TxtStatus  = $win.FindName('TxtStatus')

if ($logoImage) { $Logo.Source = $logoImage }
$TxtDir.Text = Join-Path ([Environment]::GetFolderPath('UserProfile')) 'SOZIP-Launcher'

$okBrush   = ConvertTo-Brush '#3DD68C'
$errBrush  = ConvertTo-Brush '#FF6B6B'
$warnBrush = ConvertTo-Brush '#F5B759'
$dimBrush  = ConvertTo-Brush '#9AA3B2'

$script:Request   = $null
$script:Cancelled = $false

function Set-Status([string]$text, $brush) {
  $TxtStatus.Text = $text
  if ($brush -ne $null) { $TxtStatus.Foreground = $brush }
}

function Update-Ui {
  $win.Dispatcher.Invoke([action]{}, [Windows.Threading.DispatcherPriority]::Background) | Out-Null
}

function Set-UiBusy([bool]$busy) {
  $TxtDir.IsEnabled     = -not $busy
  $BtnBrowse.IsEnabled  = -not $busy
  $ChkDesktop.IsEnabled = -not $busy
  $ChkMenu.IsEnabled    = -not $busy
  $ChkRun.IsEnabled     = -not $busy
  $BtnInstall.IsEnabled = -not $busy
}

function New-Lnk([string]$lnkPath, [string]$target, [string]$workDir, [string]$iconFile, [string]$desc) {
  $shell = New-Object -ComObject WScript.Shell
  $sc = $shell.CreateShortcut($lnkPath)
  $sc.TargetPath = $target
  $sc.WorkingDirectory = $workDir
  if ($iconFile) { $sc.IconLocation = "$iconFile,0" }
  $sc.Description = $desc
  $sc.Save()
  [Runtime.InteropServices.Marshal]::ReleaseComObject($shell) | Out-Null
}

$win.Add_Closing({
  $script:Cancelled = $true
  if ($script:Request -ne $null) { try { $script:Request.Abort() } catch { } }
})

$BtnBrowse.Add_Click({
  $fbd = New-Object System.Windows.Forms.FolderBrowserDialog
  $fbd.Description = 'Select an EMPTY folder for SOZIP LAUNCHER'
  if ($TxtDir.Text) { try { $fbd.SelectedPath = $TxtDir.Text.Trim() } catch { } }
  if ($fbd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
    $TxtDir.Text = $fbd.SelectedPath
  }
})

$BtnInstall.Add_Click({
  try {
    $dir = $null
    try {
      $raw = $TxtDir.Text.Trim().Trim('"')
      if (-not $raw)                        { throw 'Please choose an install folder.' }
      if ($raw.Contains('"'))               { throw 'Folder path may not contain quotation marks.' }
      if (-not [IO.Path]::IsPathRooted($raw)) { throw 'Please use a full folder path (for example C:\Games\SOZIP).' }
      $raw = [Environment]::ExpandEnvironmentVariables($raw)
      $dir = [IO.Path]::GetFullPath($raw).TrimEnd('\')
      if ($dir -match '^[A-Za-z]:\\?$')     { throw 'Please choose a subfolder, not a whole drive.' }
      if (Test-Path -LiteralPath $dir -PathType Leaf) { throw 'That path points to a file, not a folder.' }
      if (-not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Path $dir -Force | Out-Null
      }
      $children = @(Get-ChildItem -LiteralPath $dir -Force -ErrorAction SilentlyContinue)
      if ($children.Count -gt 0) { throw 'That folder is not empty. Please choose a fresh empty folder.' }
    } catch {
      Set-Status ([char]0x26A0 + '  ' + $_.Exception.Message) $errBrush
      return
    }

    Set-UiBusy $true
    $Bar.Visibility = 'Visible'
    $Bar.IsIndeterminate = $true
    $Bar.Value = 0
    $BtnInstall.Content = 'DOWNLOADING...'
    Set-Status 'Connecting to GitHub releases...' $dimBrush
    Update-Ui

    try {
      [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
    } catch { }

    $dest = Join-Path $dir $ExeName
    $part = "$dest.download"

    $request = [Net.HttpWebRequest]::Create($Url)
    $request.UserAgent = 'SOZIP-Setup/1.0'
    $request.AllowAutoRedirect = $true
    $script:Request = $request
    $script:Cancelled = $false

    try {
      $response = $request.GetResponse()
    } catch {
      $script:Request = $null
      if ($script:Cancelled) { return }
      Set-UiBusy $false
      $Bar.Visibility = 'Collapsed'
      $BtnInstall.Content = 'RETRY DOWNLOAD'
      Set-Status ([char]0x26A0 + '  Could not reach GitHub. Check your internet connection and try again.') $errBrush
      return
    }

    $totalBytes = [long](-1)
    try { if ($response.ContentLength -gt 0) { $totalBytes = [long]$response.ContentLength } } catch { }
    if ($totalBytes -gt 0) { $Bar.IsIndeterminate = $false; $Bar.Maximum = 100 }

    $stream = $response.GetResponseStream()
    $fileStream = [IO.File]::Create($part)
    $buffer = New-Object byte[] 65536
    $received = [long]0
    $lastPaint = [long]0
    $completed = $false

    try {
      while ($true) {
        if ($script:Cancelled) { break }
        $read = $stream.Read($buffer, 0, $buffer.Length)
        if ($read -le 0) { $completed = (-not $script:Cancelled); break }
        $fileStream.Write($buffer, 0, $read)
        $received += $read
        if (($received - $lastPaint) -ge 262144) {
          $lastPaint = $received
          if ($totalBytes -gt 0) {
            $pct = [int](($received * 100.0) / $totalBytes)
            $Bar.Value = $pct
            Set-Status ('Downloading  {0:N1} / {1:N1} MB   ({2}%)' -f ($received / 1MB), ($totalBytes / 1MB), $pct) $dimBrush
          } else {
            Set-Status ('Downloading...  {0:N1} MB' -f ($received / 1MB)) $dimBrush
          }
          Update-Ui
        }
      }
    } finally {
      $fileStream.Dispose()
      $stream.Dispose()
      $response.Close()
      $script:Request = $null
    }

    if (-not $completed) {
      Remove-Item -LiteralPath $part -Force -ErrorAction SilentlyContinue
      if ($script:Cancelled) { return }
      Set-UiBusy $false
      $Bar.Visibility = 'Collapsed'
      $BtnInstall.Content = 'RETRY DOWNLOAD'
      Set-Status ([char]0x26A0 + '  The download was interrupted. Click retry to try again.') $errBrush
      return
    }

    Move-Item -LiteralPath $part -Destination $dest -Force
    try { Unblock-File -LiteralPath $dest -ErrorAction SilentlyContinue } catch { }
    $Bar.Value = 100

    Set-Status 'Setting up shortcuts...' $dimBrush
    Update-Ui

    $notes = @()
    $exe = $dest

    # Keep the icon OUT of the game folder: store it where the shortcuts live.
    $icoFile = $null
    try {
      $icoDir = Join-Path $env:APPDATA 'SOZIP LAUNCHER'
      New-Item -ItemType Directory -Path $icoDir -Force | Out-Null
      $icoFile = Join-Path $icoDir 'sozip_icon.ico'
      [IO.File]::WriteAllBytes($icoFile, [Convert]::FromBase64String($IcoB64))
    } catch {
      try {
        $icoFile = Join-Path $dir 'sozip_icon.ico'
        [IO.File]::WriteAllBytes($icoFile, [Convert]::FromBase64String($IcoB64))
      } catch { $icoFile = $null; $notes += 'Icon file was not written.' }
    }

    $menuDir = Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs'
    $menuLnk = Join-Path $menuDir 'SOZIP LAUNCHER.lnk'
    $deskDir = [Environment]::GetFolderPath('Desktop')
    $deskLnk = Join-Path $deskDir 'SOZIP LAUNCHER.lnk'

    if ($ChkMenu.IsChecked) {
      try { New-Lnk $menuLnk $exe $dir $icoFile 'SOZIP LAUNCHER' } catch { $notes += 'Start Menu shortcut failed.' }
    }
    if ($ChkDesktop.IsChecked) {
      try { New-Lnk $deskLnk $exe $dir $icoFile 'SOZIP LAUNCHER' } catch { $notes += 'Desktop shortcut failed.' }
    }

    try {
      $uninstallBat = @'
@echo off
title SOZIP LAUNCHER Uninstaller
echo This removes SOZIP LAUNCHER, its shortcuts and all its data.
echo.
pause
del "%APPDATA%\Microsoft\Windows\Start Menu\Programs\SOZIP LAUNCHER.lnk" >nul 2>&1
del "%USERPROFILE%\Desktop\SOZIP LAUNCHER.lnk" >nul 2>&1
if defined OneDrive del "%OneDrive%\Desktop\SOZIP LAUNCHER.lnk" >nul 2>&1
rd /s /q "%APPDATA%\SOZIP LAUNCHER" >nul 2>&1
cd /d "%TEMP%"
rd /s /q "__DIR__"
'@
      $uninstallBat = $uninstallBat.Replace('__DIR__', $dir)
      [IO.File]::WriteAllText((Join-Path $dir 'Uninstall SOZIP.bat'), $uninstallBat, [System.Text.Encoding]::ASCII)
    } catch { }

    $BtnInstall.Content = 'DONE'
    $msg = [char]0x2714 + '  Installed to  ' + $dir
    if ($notes.Count -gt 0) {
      Set-Status ($msg + '   (' + ($notes -join ' ') + ')') $warnBrush
    } else {
      Set-Status $msg $okBrush
    }

    if ($ChkRun.IsChecked) {
      try { Start-Process -FilePath $exe -WorkingDirectory $dir | Out-Null } catch { }
    }
  } catch {
    try {
      if ($dir) {
        Remove-Item -LiteralPath (Join-Path $dir ($ExeName + '.download')) -Force -ErrorAction SilentlyContinue
      }
      $script:Request = $null
      Set-UiBusy $false
      $BtnInstall.Content = 'INSTALL'
      Set-Status ([char]0x26A0 + '  Something went wrong: ' + $_.Exception.Message) $errBrush
    } catch { }
  }
})

[void]$win.ShowDialog()
